# DeepSeek（服务端使用，不要加 NEXT_PUBLIC_ 前缀）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# M2 才会用到；三次调用分别对应下面两个模型
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# Notion OAuth（Public integration）。Redirect URI 必须和 Notion 后台填的完全一致。
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/notion/callback
# 可选：Internal Integration，仅本地调试、没有 OAuth 时用来读已分享页面
NOTION_API_KEY=
